  <!-- Fifteen entries cut from the file published on 2026-07-23, with the empty rows the
       export puts between entries. Chosen for what breaks the reading: a subject with
       two entries (one superseded, one valid), one with a superseded entry on the same
       date as the valid one, seven given-name spellings against three surnames, Georgian
       and Arabic script, a nationality written as "formerly Ukraine, now probably
       Russia", and the three statuses the list uses. -->
  <ItemGroup>
    <Content Include="../../fixtures/cz-mzv/sample.csv"
             Link="fixtures/cz-mzv/sample.csv"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>


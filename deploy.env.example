# Copy to deploy.env (git-ignored) and fill in. Sourced by deploy.sh.
#
# Nothing here is a secret, but the SSH user and host together are not for a public
# repository either. The database password and the Google client id are NOT here: they
# live in docker-compose.yml on the host, which deploy.sh never touches.

# SSH target. Key or password, whatever your ssh is set up for.
DEPLOY_HOST=you@your.host

# Public base URL the deploy is verified against; /health must answer there.
DEPLOY_URL=https://api.example.org

# Optional, with these defaults:
# DEPLOY_DIR=sancmeld          directory under the remote home, holding docker-compose.yml
# DEPLOY_IMAGE=sancmeld-api    image name docker-compose.yml refers to
# DEPLOY_PORT=5210             host port docker-compose.yml publishes 8080 on

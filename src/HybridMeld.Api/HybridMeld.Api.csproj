<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HybridMeld.Api</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Google sign-in by verifying the ID token's signature against Google's published
       keys, as in SancMeld.Api and PepMeld.Api: no client secret anywhere. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../HybridMeld.Core/HybridMeld.Core.csproj" />
  </ItemGroup>

</Project>

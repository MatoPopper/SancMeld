<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SancMeld.Connectors.Wikidata</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SancMeld.Connectors.Wikidata.Tests" />
    <InternalsVisibleTo Include="SancMeld.Core.IntegrationTests" />
  </ItemGroup>

  <!-- SPARQL over HTTP and JSON results: the framework covers both. No RDF library,
       because every query here projects to a flat table and nothing walks a graph. -->

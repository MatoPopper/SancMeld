{
  "//": [
    "Committed defaults. NEVER put a connection string, password or token here.",
    "",
    "The 'ConnectionStrings' section is deliberately absent. Supply it via:",
    "  development  -> dotnet user-secrets set \"ConnectionStrings:SancMeld\" \"...\"",
    "  docker/prod  -> environment variable ConnectionStrings__SancMeld=...",
    "  local file   -> appsettings.Development.json (git-ignored)",
    "",
    "Sanctions sources are NOT configured here: they live in the sanctions_source",
    "table so imports, snapshots and designations can reference them by key."
  ],

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "SancMeld": {
    "Ingest": {
      "SnapshotStoragePath": "./.snapshots",
      "UserAgent": "SancMeld/1.0 (+https://github.com/MatoPopper/SancMeld)",
      "DownloadTimeoutSeconds": 600,
      "DownloadRetryCount": 3
    },
    "Matching": {
      "SimilarityThreshold": 0.35,
      "MaxCandidates": 100,
      "ScoreWeakAliases": false
    }
  }
}
